# Explicit --env-file avoids Compose treating the existing .env/ directory as a file.
# Environment variables supplied to tools/docker.sh override these defaults.
ROBOTWIN_IMAGE=robotwin-phys:cuda12.1
# The wrapper detects available GPUs and overrides this Compose-only fallback.
ROBOTWIN_GPU=0
ROBOTWIN_CUDA_ARCH=7.5
ROBOTWIN_BUILD_JOBS=4
